# Frontend & DB Auth
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# Backend Privileged (Orchestrator & Webhook)
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Meta Graph API
META_APP_SECRET="your_meta_app_secret_here"
META_VERIFY_TOKEN="your_meta_verify_token_here"
META_ACCESS_TOKEN="your_meta_access_token_here"
WHATSAPP_PHONE_ID="your_whatsapp_phone_id_here"

# Generative AI Neural Engine
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Local CLI / Direct DB Connections
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
SUPABASE_PROJECT_REF="your_project_ref_here"
SUPABASE_DB_PASSWORD="your_db_password_here"
