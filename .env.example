# Frontend & DB Auth
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# Backend Privileged (Orchestrator & Webhook)
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# URL pública del frontend — usada en Server Actions (invite flow)
# Local: http://localhost:3000 | Producción: https://commerce-ops-web.onrender.com (fijo en render.yaml)
APP_URL="http://localhost:3000"

# Meta Graph API
META_APP_SECRET="your_meta_app_secret_here"
META_VERIFY_TOKEN="your_meta_verify_token_here"
META_ACCESS_TOKEN="your_meta_access_token_here"
WHATSAPP_PHONE_ID="your_whatsapp_phone_id_here"

# Generative AI Neural Engine
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Local CLI / Direct DB Connections
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
SUPABASE_PROJECT_REF="your_project_ref_here"
SUPABASE_DB_PASSWORD="your_db_password_here"

# API Gateway JWT validation (Supabase Dashboard → Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET="your_jwt_secret_here"

# Mercado Libre API Credentials
MELI_CLIENT_ID="your_meli_client_id_here"
MELI_CLIENT_SECRET="your_meli_client_secret_here"
MELI_REDIRECT_URI="your_meli_redirect_uri_here"
MELI_AUTH_URL="https://auth.mercadolibre.com.co/authorization"

# Token for Telegram Bot (if using Telegram as a channel)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Envia API Key
ENVIA_API_KEY="your_envia_api_key_here"