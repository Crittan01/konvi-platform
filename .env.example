# =============================================================================
# CONTRATO DE ENTORNO — Konvi Platform (canónico, línea a línea documentado)
# =============================================================================
# Convención de archivos (2026-08-14) — PARIDAD local↔PRD por consumidor:
#   .env.example        ← ESTE archivo: el CONTRATO en git (sin valores reales).
#   .env.local          ← gitignored. STG: los 3 servicios Python (api, connector,
#                         orchestrator) + scripts + .local/Makefile. Es la paridad
#                         de las vars que en PRD comparten konvi-api/connector/orchestrator.
#   apps/web/.env.local ← gitignored. STG: SOLO las vars del web. Es la paridad
#                         de konvi-web en Render (que tiene solo las suyas).
#                         Next.js lo exige por convención (lo carga solo).
#   .env.prd-backup     ← gitignored. BACKUP de las vars de las plataformas
#                         integradas (Render/Supabase/etc.) para operación prod.
#
# Reglas:
#  1. `.env*` con valores reales NUNCA al repositorio.
#  2. Paridad: cada consumidor lee SOLO lo suyo (como en PRD) — sin megáfono
#     compartido ni symlinks que rompan la paridad.
#  2. Tags por variable:
#       [PRD]      — se setea en Render (dashboard de cada servicio).
#       [STG]      — desarrollo local (`.env` raíz y/o `apps/web/.env.local`).
#       [AMBOS]    — requerida en ambos ambientes.
#       [SCRIPTS]  — solo para scripts admin/UAT locales (no runtime).
#       [ELIMINAR] — muerta (0 usos en código, verificado 2026-08-14). Borrarla.
#  3. Las credenciales PER-TENANT (Wompi/Meta/Aveonline/Telegram keys, Meta App
#     Secret, System User tokens) NO van en env: viven en `tenant_integrations`
#     + Supabase Vault (ADR-0023 Model B). Aquí solo las de PLATAFORMA.
#  4. Anti-drift: tests/test_env_contract_guard.py verifica que este archivo
#     cubre todas las vars que el código lee y no documenta muertas.
# =============================================================================


## ─── Supabase ───────────────────────────────────────────────────────────────
# URL del proyecto. PRD: https://<ref>.supabase.co · STG: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=""                        # [AMBOS]
# Publishable (nueva generación de keys). PRD: sb_publishable_… · STG: demo del CLI.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""            # [AMBOS]
# Secret (backend, bypassa RLS — NUNCA en el browser). PRD: sb_secret_… · STG: demo.
SUPABASE_SECRET_KEY=""                             # [AMBOS]
# (Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY eliminadas en
#  G23 2026-08-19: el código ya no las lee y están desactivadas a nivel Supabase.)
# LEGACY A0.2c — JWT secret HS256 (auth usa JWKS ES256; solo fallback opcional). [AMBOS]
SUPABASE_JWT_SECRET=""
# Ref del proyecto Supabase. [SCRIPTS] (env_guard, replay migraciones)
SUPABASE_PROJECT_REF=""
# Conexión directa a la DB local (STG; para scripts/harness). [STG]
DATABASE_URL=""


## ─── Interno (service-to-service y URLs de servicios) ───────────────────────
# Shared secret orchestrator/connector → api (X-Internal-Service-Secret).
# Generar con `openssl rand -hex 32`. [AMBOS]
INTERNAL_SERVICE_SECRET=""
# EFÍMERA — ventana de rotación (runbook credential-rotation §A): el secret
# saliente mientras dura el flip. FUERA de la ventana debe estar VACÍA. [PRD]
INTERNAL_SERVICE_SECRET_PREVIOUS=""
# URL del Core API. STG: http://localhost:8001 · PRD: https://konvi-api.onrender.com [AMBOS]
API_URL=""
# URL pública de la app web. STG: http://localhost:3000 · PRD: https://konvi-web.onrender.com [AMBOS]
APP_URL=""
NEXT_PUBLIC_APP_URL=""                             # [AMBOS] (la misma que APP_URL, expuesta al browser)
# Host público para webhooks externos (Wompi/MeLi/Aveonline) si no es la de Render. [PRD]
PUBLIC_WEBHOOK_URL=""


## ─── LLM ────────────────────────────────────────────────────────────────────
# Gemini. PRD: authorized key restringida a Generative Language API (las
# "standard" mueren sept-2026). [AMBOS]
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"                    # [AMBOS] (override; default en código)
AGENTIC_MODEL="gemini-3.1-flash-lite"              # [AMBOS] (modelo del path agentic)
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"        # [AMBOS]
GEMINI_EMBEDDING_FALLBACK_MODEL="gemini-embedding-2"  # [AMBOS]
GEMINI_EMBEDDING_DIM="3072"                        # [AMBOS]
# Fallback Whisper multimodal (audio→texto). SÍ se usa — NO eliminar. [AMBOS]
OPENAI_API_KEY=""
# Rescue opcional del cascade LLM (si está, hay tier Claude). [AMBOS]
ANTHROPIC_API_KEY=""


## ─── Resend (email transaccional) ───────────────────────────────────────────
RESEND_API_KEY=""                                  # [AMBOS]
RESEND_FROM_EMAIL="Konvi <noreply@tu-dominio.com>" # [AMBOS] (requiere dominio verificado en Resend)


## ─── Mercado Libre (OAuth de PLATAFORMA — el token del tenant va en Vault) ──
MELI_CLIENT_ID=""                                  # [PRD]
MELI_CLIENT_SECRET=""                              # [PRD]
MELI_REDIRECT_URI=""                               # [PRD] (https — el callback OAuth)
MELI_AUTH_URL="https://auth.mercadolibre.com/authorization"  # [PRD]
MELI_OAUTH_STATE_SECRET=""                         # [PRD] (firma del state OAuth)
MELI_WEBHOOK_ALERT_THRESHOLD="50"                  # [PRD] (tuning; default en código)
MELI_WEBHOOK_ALERT_WINDOW_SECONDS="300"            # [PRD]
MELI_WEBHOOK_ALLOWED_IPS=""                        # [PRD] (override del allowlist default)


## ─── Aveonline (flag de plataforma; las credenciales van per-tenant en Vault) ─
# Doble compuerta con real_guides_enabled per-tenant. false = guías simuladas. [PRD]
AVEONLINE_GENERATE_REAL_GUIDES="false"


## ─── Wompi (solo el AMBIENTE — las keys van per-tenant en Vault) ────────────


## ─── Telegram (solo firma del webhook de plataforma; bot tokens per-tenant en Vault) ─
TELEGRAM_WEBHOOK_SECRET=""                         # [PRD]


## ─── WhatsApp / Meta (Model B: credenciales per-tenant en Vault) ────────────
META_GRAPH_API_VERSION="v22.0"                     # [AMBOS] (bump calendarizado Q4-2026)
META_MEDIA_MAX_BYTES="16777216"                    # [AMBOS] (cap descarga media inbound)
META_MEDIA_DOWNLOAD_TIMEOUT_SECONDS="25"           # [AMBOS]
WHATSAPP_CONNECTOR_URL=""                          # [PRD] (URL del connector, para health/notify)


## ─── Seguridad / MFA ─────────────────────────────────────────────────────────
# Flip MFA obligatorio para write-roles (runbook mfa-mandatory-rollout). [PRD]
MFA_MANDATORY_ENABLED="false"
MFA_MANDATORY_GRACE_DAYS="14"                      # [PRD]
MFA_MANDATORY_START=""                             # [PRD] (ISO date — ancla de la gracia)
# Firma de la cookie mfa_recovery_session (24h). Solo web. [PRD]
MFA_RECOVERY_COOKIE_SECRET=""
# Cap de body del gateway (413). [PRD]
MAX_REQUEST_BODY_BYTES="2097152"
# CORS del api. [PRD]
ALLOWED_ORIGINS="http://localhost:3000"


## ─── Feature flags / tuning runtime (defaults en código; solo override) ─────
