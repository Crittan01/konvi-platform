# =============================================================================
# Konvi — .env.example (referencia canónica)
# Última revisión: 2026-05-31 (rev. 109 — A0.1 normalize env vars)
#
# REGLAS:
#   - NO subir .env ni .env.local al repositorio (.gitignore los excluye)
#   - Variables marcadas [LOCAL] solo se usan en la VM de desarrollo, NO van a Render
#   - Variables marcadas [RENDER] deben configurarse también en render.yaml o en el
#     Dashboard de Render como secrets (sync: false)
#   - Variables marcadas [DB] se almacenan por-tenant en Supabase, no en env vars
#   - Variables marcadas [DEPRECATED] no usar en código nuevo
#   - Variables marcadas [TRANSITIONAL] están temporalmente activas hasta refactor
#     planeado — ver docs/research/audit-finiquito-2026-05-31.md
# =============================================================================

# ── BASE — Supabase (todos los servicios) ─────────────────────────────────────
# [RENDER] Configurar en todos los servicios de Render
# Sistema NUEVO (canónico): Publishable + Secret API keys.
# https://supabase.com/docs/guides/getting-started/api-keys
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"  # web (cliente browser)
SUPABASE_SECRET_KEY="sb_secret_your_key_here"                        # backend (SSR, api, connector, orchestrator)

# [DEPRECATED / TRANSITIONAL] Legacy API keys — todavía leídas por código pre-refactor.
# Configurar con el MISMO valor que las nuevas (Render no permite alias). Eliminar
# bloque cuando A0.2b (apps/web) + A0.2c (services Python) terminen migration.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_key_here"         # = PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_key_here"                  # = SECRET_KEY

# [TRANSITIONAL] Legacy JWT secret — aún requerido por services/api/dependencies/auth.py
# + tools/payment_link_tool.py + tools/shipping_quote_tool.py hasta refactor A0.2b/A0.2c
# (migration a JWKS asymmetric + INTERNAL_SERVICE_SECRET service-to-service).
# Origen: Supabase Dashboard → Project Settings → API → JWT Settings → Legacy JWT Secret.
SUPABASE_JWT_SECRET="your_legacy_jwt_secret_here"

# ── LOCAL ÚNICAMENTE — no van a Render ───────────────────────────────────────
# Supabase CLI (supabase db query, supabase migration)
SUPABASE_PROJECT_REF="your_project_ref_here"
SUPABASE_DB_PASSWORD="your_db_password_here"
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# [RENDER api + orchestrator] Auth service-to-service interna (post-A0.2c).
# Reemplaza el truco JWT HS256 actual de payment_link_tool + shipping_quote_tool.
# Generar con: `openssl rand -hex 32`. MISMO valor en api + orchestrator.
INTERNAL_SERVICE_SECRET=""

# ── URLs por servicio ─────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"                # web — local: localhost, Render: https://commerce-ops-web.onrender.com
API_URL="http://localhost:8001"                # orchestrator + web — local: localhost, Render: https://commerce-ops-api.onrender.com
ALLOWED_ORIGINS="http://localhost:3000"        # api + connector — local: localhost, Render: https://commerce-ops-web.onrender.com

# ngrok (Makefile local — para webhooks desde Meta y MeLi en dev)
NGROK_AUTHTOKEN="your_ngrok_authtoken"
NGROK_AUTHTOKEN_CONNECTOR="your_ngrok_authtoken_connector"
NGROK_DOMAIN_API="your-api-subdomain.ngrok-free.app"
NGROK_DOMAIN_CONNECTOR="your-connector-subdomain.ngrok-free.app"

# Rutas de servicios locales (desarrollo)
CONNECTOR_URL="http://localhost:8000"
ORCHESTRATOR_URL="http://localhost:8002"
NEXT_PUBLIC_API_URL="http://localhost:8001"    # [DEPRECATED] usar API_URL en server-side

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE: commerce-ops-web (apps/web)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL      (ver BASE)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (ver BASE)
# SUPABASE_SECRET_KEY     (ver BASE)
# APP_URL                       (ver URLs)
# API_URL                       (ver URLs)
# NODE_ENV="production"          — Render lo gestiona automáticamente
# NEXT_TELEMETRY_DISABLED="1"   — Render lo configura en render.yaml

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE: commerce-ops-connector (services/connector-whatsapp)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL   (ver BASE)
# SUPABASE_SECRET_KEY  (ver BASE)
# ALLOWED_ORIGINS            (ver URLs)

# [RENDER] Credenciales WhatsApp inbound (webhook de Meta)
META_APP_SECRET="your_meta_app_secret"
META_VERIFY_TOKEN="your_meta_verify_token"

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE: commerce-ops-api (services/api)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL   (ver BASE)
# SUPABASE_SECRET_KEY  (ver BASE)
# ALLOWED_ORIGINS            (ver URLs)

# [RENDER] Mercado Libre OAuth (Fase 10)
MELI_CLIENT_ID="your_meli_app_client_id"
MELI_CLIENT_SECRET="your_meli_app_client_secret"
MELI_REDIRECT_URI="https://commerce-ops-api.onrender.com/api/v1/integrations/meli/callback"
MELI_AUTH_URL="https://auth.mercadolibre.com.co/authorization"
MELI_OAUTH_STATE_SECRET="change_me_long_random_secret_min_32_chars"
MELI_OAUTH_STATE_TTL_SECONDS="600"

# [RENDER] Telegram Webhook bidireccional (F6)
# IH: configurar setWebhook antes de activar
#   curl "https://api.telegram.org/bot{TOKEN}/setWebhook" \
#     -d "url=https://commerce-ops-api.onrender.com/api/v1/integrations/telegram/webhook" \
#     -d "secret_token={TELEGRAM_WEBHOOK_SECRET}"
TELEGRAM_WEBHOOK_SECRET="secret_compartido"   # Secret compartido con Telegram (setWebhook)

# [DB] Wompi Pagos — credenciales por-tenant en Supabase Vault
# Las llaves se ingresan por tenant en Ajustes → Integraciones → Wompi.
# Almacenadas en tenant_integrations (provider='wompi') + Vault (encriptadas).
# NO se requieren env vars globales. Webhook URL a configurar en Wompi Dashboard:
#   Sandbox (local): https://<ngrok>/api/v1/webhooks/wompi
#   Producción:      https://commerce-ops-api.onrender.com/api/v1/webhooks/wompi

# [RENDER] Feature flags
PLAN_ENFORCEMENT_ENABLED="true"
# Nota rev. 109: ENVIA_PHASE2_ENABLED eliminado con pivote a Aveonline (ADR-0019).

# [RENDER] Rate limiting
API_RATE_LIMIT_ENABLED="true"
API_RATE_LIMIT_WRITE_PER_MINUTE="120"
API_RATE_LIMIT_SEND_PER_MINUTE="40"
API_RATE_LIMIT_DISTRIBUTED="true"              # Requiere migración 20260425000000

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE: commerce-ops-orchestrator (services/ai-orchestrator)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL   (ver BASE)
# SUPABASE_SECRET_KEY  (ver BASE)
# API_URL                    (ver URLs)

# [RENDER] Gemini AI
# Rev. 72 — GEMINI_API_KEY se usa en commerce-ops-orchestrator (razonamiento del bot)
# y en commerce-ops-api (cálculo de embeddings KB server-side via /api/v1/knowledge-base).
# Ya NO es necesaria en commerce-ops-web (cierre drift D3).
# Notas residuales en commerce-ops-web (apps/web/app/api/insights y .../ai/preview):
# son SSR Next.js Server Routes, no exponen la key al browser. Si se quiere mover
# también esos endpoints al API service, queda como deuda técnica futura.
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_FALLBACK_MODEL="text-embedding-004"

# [RENDER orchestrator] Fallback LLM tier 4 (rev. 109 cascade multi-vendor).
# Solo se invoca si Gemini Flash Lite/Flash/Pro fallan consecutivos. Opcional.
OPENAI_API_KEY="your_openai_api_key"

# [RENDER] Shipping defaults para estimación de paquetes (cuando product_variations no tiene dimensiones)
INBOX_SHIPPING_DEFAULT_WEIGHT_KG="1"
INBOX_SHIPPING_DEFAULT_LENGTH_CM="10"
INBOX_SHIPPING_DEFAULT_WIDTH_CM="10"
INBOX_SHIPPING_DEFAULT_HEIGHT_CM="10"
INBOX_SHIPPING_TIMEOUT_SECONDS="25"

# [RENDER] Worker config
POLL_INTERVAL_SECONDS="3"
MAX_PROCESSING_ATTEMPTS="5"
CONVERSATION_HISTORY_LIMIT="25"               # Min recomendado para flujo de compra completo
CONVERSATION_WINDOW_HOURS="24"               # Ventana de mensajería WhatsApp (24h por política Meta)

# [RENDER] Cola de human takeover (Supabase Queues / pgmq)
HUMAN_TAKEOVER_QUEUE_ENABLED="true"
HUMAN_TAKEOVER_QUEUE_POLL_BATCH="10"
HUMAN_TAKEOVER_QUEUE_VT_SECONDS="90"

# [RENDER] Cola de outbound WhatsApp (Supabase Queues / pgmq)
WHATSAPP_OUTBOUND_QUEUE_ENABLED="true"
WHATSAPP_OUTBOUND_QUEUE_POLL_BATCH="20"
WHATSAPP_OUTBOUND_QUEUE_VT_SECONDS="90"
WHATSAPP_OUTBOUND_MAX_ATTEMPTS="5"

# [RENDER] Mantenimiento periódico (idempotency + rate limits + pedidos expirados)
IDEMPOTENCY_CLEANUP_ENABLED="true"
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS="3600"
IDEMPOTENCY_CLEANUP_BATCH="2000"
PENDING_PAYMENT_RELEASE_ENABLED="true"        # Cancela pending_payment expirados (TTL)
PENDING_PAYMENT_RELEASE_INTERVAL_SECONDS="600"
PENDING_PAYMENT_TTL_MINUTES="35"              # 5 min sobre el TTL del link Wompi (30 min)

# [REV. 103 F1] Recordatorio de pago dentro de la ventana CSW (Meta 24h).
# Solo dispara free-form si el último inbound del cliente es < META_CSW_HOURS.
# Fuera de CSW: skip + mark idempotent (F2 cubrirá con templates HSM).
PAYMENT_REMINDER_ENABLED="true"
PAYMENT_REMINDER_INTERVAL_SECONDS="60"        # Cron interno cada 1 min
PAYMENT_REMINDER_DELAY_MINUTES="25"           # Recordar a los 25 min de la orden (link Wompi vence a los 30)
PAYMENT_REMINDER_WINDOW_MINUTES="5"           # Ventana de recordatorio (25..30 min)
META_CSW_HOURS="24"                           # Customer Service Window de Meta (no cambiar salvo que Meta lo modifique)

# [RENDER api] URL pública base donde providers externos registran webhooks.
# Aveonline `webhookEstadosGuias` POSTea aquí. Producción: https://api.konvi.app
# Sandbox/dev: usar ngrok dominio (https://<nombre>.ngrok-free.dev).
PUBLIC_WEBHOOK_URL="https://your-ngrok-or-render-domain"

# [RENDER] Anti-hibernación (solo Render Free — el servicio hiberna tras 15 min de inactividad)
ANTI_HIBERNATION_ENABLED="false"              # Activar: "true"
ANTI_HIBERNATION_PING_URL=""                  # Comma-separated: https://...web.onrender.com/api/health,https://...api.onrender.com/health
ANTI_HIBERNATION_INTERVAL_SECONDS="840"       # 14 min

# [RENDER] MeLi webhook IP allowlist (opcional override).
# El default ya incluye las 4 IPs oficiales documentadas en MeLi (verificada 2026-04-28).
# Solo configurar aquí si MeLi publica IPs nuevas y aún no se actualizó el código.
# CSV de IPs/CIDRs: "54.88.218.97,18.215.140.160,..."
MELI_WEBHOOK_ALLOWED_IPS=""

# [RENDER] Multimodal — comprensión de audios de WhatsApp con Gemini 2.5 Flash.
# Default activo. Apagar en caliente sin redeploy si genera issues en producción.
MULTIMODAL_AUDIO_ENABLED="true"
META_MEDIA_MAX_BYTES="16777216"               # 16MB — límite Meta para audio
META_MEDIA_DOWNLOAD_TIMEOUT_SECONDS="10"      # Timeout descarga media de Meta CDN

# [RENDER] Rev. 69 — Customer context (cliente conocido) y MeLi alertas
# CUSTOMER_CONTEXT_ENABLED: kill switch global del bloque CONTEXTO DEL CLIENTE.
# CUSTOMER_CONTEXT_MODE: 'always' | 'lazy' (default) | 'disabled'.
#   - lazy: carga el contexto solo si la query del cliente menciona pedido/orden/envío/reclamo/etc.
#   - always: siempre carga (rev. 68 default — más tokens).
#   - disabled: nunca carga.
CUSTOMER_CONTEXT_ENABLED="true"
CUSTOMER_CONTEXT_MODE="lazy"

# [RENDER] Rev. 70 (F7-lite) — Cart recovery reactivo
# CART_RECOVERY_ENABLED: kill switch del bloque CARRITO PREVIO en system prompt.
# CART_RECOVERY_LOOKBACK_DAYS: ventana en días para considerar una orden cancelled
#   por timeout como "carrito recuperable". Default 7 (1-60).
CART_RECOVERY_ENABLED="true"
CART_RECOVERY_LOOKBACK_DAYS="7"

# MeLi webhook alerta proactiva — emite log warning cuando excede umbral de rechazos.
# El operador filtra por `meli_webhook.alert_threshold_exceeded` en Render Dashboard.
MELI_WEBHOOK_ALERT_THRESHOLD="5"
MELI_WEBHOOK_ALERT_WINDOW_SECONDS="300"

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACION POR-TENANT EN SUPABASE (NO son env vars del servicio)
# ─────────────────────────────────────────────────────────────────────────────
# Las siguientes credenciales se almacenan en tenant_integrations o notification_settings
# en la base de datos. No se configuran como env vars en Render.
#
# [DB] WhatsApp (envío):
#   → tenant_integrations: provider='whatsapp', credentials={access_token, phone_number_id}
#
# [DB] Aveonline (shipping, provider único activo ADR-0019):
#   → tenant_integrations: provider='aveonline', credentials={usuario, password_secret_id}
#   → Para Courier N+1 ver ADR-0023 (Shipping Provider Integration Pattern)
#
# [DB] Wompi (pagos):
#   → tenant_integrations: provider='wompi', credentials={private_key_secret_id, events_key_secret_id}
#   → meta: {environment, private_key_preview}
#
# [DB] Telegram (notificaciones de takeover):
#   → notification_settings: channel='telegram', config={bot_token, chat_id}
#
# [DB] Email (notificaciones — placeholder hasta SMTP productivo):
#   → notification_settings: channel='email', config={...}

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — Resend (Habeas Data notifications, rev. 94)
# ─────────────────────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY: notifications.py loguea en lugar de enviar email
# (fallback graceful por diseño — no rompe flujos críticos).
# Para activar en producción:
#   1. Crear cuenta https://resend.com (free 100/día, paid $20/mo 10k/día).
#   2. Configurar la key en Render Dashboard (NO commitear).
#   3. Verificar dominio en Resend si se requiere from custom.
# [RENDER] Configurar en commerce-ops-orchestrator (sync: false).
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Commerce Ops <noreply@commerce-ops.local>"

# ─────────────────────────────────────────────────────────────────────────────
# SENTRY — Observability (Rev. 109 J.2.7.4 tracing E2E cross-service)
# ─────────────────────────────────────────────────────────────────────────────
# Sentry tiene su propia UI (sentry.io). Solo founder + equipo SaaS acceden.
# Captura: errors + traces cross-service (browser → Next → API → Orchestrator).
# Sin DSN: SDK inert (logs warning, no crashea). Producción ESPERA tener DSN.
#
# Setup founder (~30 min):
#   1. Crear cuenta https://sentry.io (free 5k events/mo).
#   2. Crear 4 projects: konvi-api, konvi-orchestrator, konvi-connector,
#      konvi-web. Tomar DSN de cada uno.
#   3. Configurar Render Dashboard env vars per servicio (sync: false).
#   4. Para source maps upload de apps/web: SENTRY_AUTH_TOKEN (Settings →
#      Account → API, scope project:releases + project:write).
#
# [RENDER] 4 DSNs distintos (uno per service) + SENTRY_AUTH_TOKEN para web.
SENTRY_DSN="https://your-key@oXXXX.ingest.sentry.io/PROJECT_ID"
SENTRY_TRACES_SAMPLE_RATE="0.1"    # 10% sampling backend Python — subir para debug, bajar prod
SENTRY_ENV="development"           # staging | production | development

# Solo apps/web — NEXT_PUBLIC_ porque va al bundle browser:
NEXT_PUBLIC_SENTRY_DSN="https://your-key@oXXXX.ingest.sentry.io/PROJECT_ID"
NEXT_PUBLIC_SENTRY_TRACES_RATE="0.1"
NEXT_PUBLIC_SENTRY_ENV="development"

# Build-time only (apps/web) — source map upload + release tagging:
SENTRY_ORG="konvi"
SENTRY_PROJECT="konvi-web"
SENTRY_AUTH_TOKEN="sntrys_your_build_token_here"

# ─────────────────────────────────────────────────────────────────────────────
# DEPRECATED — no usar en código nuevo
# ─────────────────────────────────────────────────────────────────────────────
# META_ACCESS_TOKEN — ahora por-tenant en tenant_integrations
# WHATSAPP_PHONE_ID — ahora por-tenant en tenant_integrations
# NEXT_PUBLIC_API_URL — deprecada, usar API_URL en server-side
