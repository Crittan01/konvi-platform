# =============================================================================
# Commerce Ops Platform — .env.example (vigente)
# No subir .env real al repositorio.
# =============================================================================

# ── Supabase base (web + api + connector + orchestrator) ────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_JWT_SECRET="your_jwt_secret_here"

# ── URLs internas/externas ───────────────────────────────────────────────────
APP_URL="http://localhost:3000"
API_URL="http://localhost:8001"
# Compat legacy (deprecado; mantener solo mientras existan fallback en server code):
NEXT_PUBLIC_API_URL="http://localhost:8001"
ALLOWED_ORIGINS="http://localhost:3000"

# ── AI / Orchestrator ────────────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
INBOX_SHIPPING_DEFAULT_WEIGHT_KG="1"
INBOX_SHIPPING_DEFAULT_LENGTH_CM="10"
INBOX_SHIPPING_DEFAULT_WIDTH_CM="10"
INBOX_SHIPPING_DEFAULT_HEIGHT_CM="10"
INBOX_SHIPPING_TIMEOUT_SECONDS="25"
POLL_INTERVAL_SECONDS="3"
MAX_PROCESSING_ATTEMPTS="3"
CONVERSATION_HISTORY_LIMIT="10"

HUMAN_TAKEOVER_QUEUE_ENABLED="true"
HUMAN_TAKEOVER_QUEUE_POLL_BATCH="10"
HUMAN_TAKEOVER_QUEUE_VT_SECONDS="90"

WHATSAPP_OUTBOUND_QUEUE_ENABLED="true"
WHATSAPP_OUTBOUND_QUEUE_POLL_BATCH="20"
WHATSAPP_OUTBOUND_QUEUE_VT_SECONDS="90"
WHATSAPP_OUTBOUND_MAX_ATTEMPTS="5"

IDEMPOTENCY_CLEANUP_ENABLED="true"
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS="3600"
IDEMPOTENCY_CLEANUP_BATCH="2000"

# ── API hardening / planes ───────────────────────────────────────────────────
PLAN_ENFORCEMENT_ENABLED="true"
ENVIA_PHASE2_ENABLED="false"
API_RATE_LIMIT_WRITE_PER_MINUTE="120"
API_RATE_LIMIT_SEND_PER_MINUTE="40"

# ── Meta WhatsApp (connector inbound) ────────────────────────────────────────
META_APP_SECRET="your_meta_app_secret_here"
META_VERIFY_TOKEN="your_meta_verify_token_here"

# ── Mercado Libre OAuth ──────────────────────────────────────────────────────
MELI_CLIENT_ID="your_meli_client_id_here"
MELI_CLIENT_SECRET="your_meli_client_secret_here"
MELI_REDIRECT_URI="your_meli_redirect_uri_here"
MELI_AUTH_URL="https://auth.mercadolibre.com.co/authorization"
MELI_OAUTH_STATE_SECRET="change_me_long_random_secret"
MELI_OAUTH_STATE_TTL_SECONDS="600"

# ── Supabase CLI / utilidades ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
SUPABASE_PROJECT_REF="your_project_ref_here"
SUPABASE_DB_PASSWORD="your_db_password_here"

# ── Scripts locales de prueba (opcional) ─────────────────────────────────────
TEST_TENANT_ID="00000000-0000-0000-0000-000000000000"
TEST_CATEGORY_ID="00000000-0000-0000-0000-000000000000"
