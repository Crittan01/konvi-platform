# ─── Python ───────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
*.pyo
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/

# ─── Node / pnpm ──────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.npm/

# ─── Next.js Build Artifacts ──────────────────────────────────────────────────
apps/web/.next/
apps/web/out/
.next/
out/
*.tsbuildinfo

# ─── Environment (NUNCA al repositorio) ───────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Supabase Local ───────────────────────────────────────────────────────────
supabase/.temp/

# ─── OS / IDEs ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
packages/auth/node_modules/

# ─── Scratch / Debug local ────────────────────────────────────────────────────
# Archivos temporales de sesión y scripts ad-hoc — no son parte del producto
scratch/
scratch*.py
scratch*.js
scripts/debug/

# ─── Claude Code runtime artifacts ────────────────────────────────────────────
# Lock file regenerado automáticamente — no debe ir al repo.
.claude/scheduled_tasks.lock

# ─── UAT logs (transcripts de conversaciones de prueba) ──────────────────────
# Generados por scripts/uat/scenarios/*.py — útiles localmente, no compartir.
scripts/uat/logs/

# ─── packages/db/migrations — snapshot legacy (no canónico) ──────────────────
# Fuente de verdad: supabase/migrations/
# packages/db/migrations/ es un snapshot histórico divergido
packages/db/migrations/

# ─── infra/ subdirectorios vacíos ─────────────────────────────────────────────
infra/render/
infra/local/
infra/supabase/

# ─── Artefactos Python adicionales ────────────────────────────────────────────
pip-selfcheck.json
.mypy_cache/
.ruff_cache/

# Stack local runtime (Makefile, logs, pids, ngrok-configs) — NO versionar
.local/
.env.dev
.env.prod
.env.local.prod
